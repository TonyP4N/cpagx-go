{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PacketObservationArtifact.schema.json",
  "title": "PacketObservationArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_version",
    "synthetic",
    "file_sha256",
    "events",
    "graph",
    "observations",
    "unsupported",
    "connection_controls",
    "quality",
    "schema_version"
  ],
  "properties": {
    "adapter_version": {
      "const": "synthetic-packet-1"
    },
    "synthetic": {
      "const": true
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "NetworkEvent.schema.json"
      }
    },
    "graph": {
      "$ref": "GraphArtifact.schema.json"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_refs",
          "field_slices",
          "fields",
          "pdu_sha256",
          "pdu_hex",
          "epoch",
          "direction",
          "association_status",
          "association_reason",
          "endpoints",
          "service",
          "session_handle",
          "sender_context",
          "timeout_raw",
          "operation",
          "quality",
          "data_hex"
        ],
        "properties": {
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "SourceReference.json"
            }
          },
          "field_slices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_ref": {
                  "$ref": "SourceReference.json"
                },
                "frame_byte_offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 262144
                },
                "pdu_byte_offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 262144
                },
                "length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 262144
                },
                "hex": {
                  "type": "string",
                  "pattern": "^([a-f0-9]{2})+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "source_ref",
                "frame_byte_offset",
                "pdu_byte_offset",
                "length",
                "hex",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "pdu_byte_offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 262144
                },
                "length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 262144
                },
                "hex": {
                  "type": "string",
                  "pattern": "^([a-f0-9]{2})+$"
                },
                "slices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_ref": {
                        "$ref": "SourceReference.json"
                      },
                      "frame_byte_offset": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 262144
                      },
                      "pdu_byte_offset": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 262144
                      },
                      "length": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 262144
                      },
                      "hex": {
                        "type": "string",
                        "pattern": "^([a-f0-9]{2})+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "source_ref",
                      "frame_byte_offset",
                      "pdu_byte_offset",
                      "length",
                      "hex",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "pdu_byte_offset",
                "length",
                "hex",
                "slices"
              ],
              "additionalProperties": false
            }
          },
          "pdu_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pdu_hex": {
            "type": "string",
            "pattern": "^([a-f0-9]{2})+$"
          },
          "epoch": {
            "type": "integer",
            "minimum": 0
          },
          "direction": {
            "enum": [
              "request",
              "response"
            ]
          },
          "association_status": {
            "enum": [
              "matched",
              "missing",
              "ambiguous",
              "unsupported"
            ]
          },
          "association_reason": {
            "type": "string"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            }
          },
          "service": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "session_handle": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "sender_context": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "timeout_raw": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "operation": {
            "enum": [
              "read_attribute",
              "write_attribute"
            ]
          },
          "quality": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "object",
            "properties": {
              "class": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "instance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "attribute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            "required": [
              "class",
              "instance",
              "attribute"
            ],
            "additionalProperties": false
          },
          "data_hex": {
            "type": "string",
            "pattern": "^([a-f0-9]{2})*$"
          },
          "general_status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "additional_status": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        "additionalProperties": false
      }
    },
    "unsupported": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "SourceReference.json"
            }
          }
        },
        "required": [
          "reason",
          "source_refs"
        ],
        "additionalProperties": false
      }
    },
    "connection_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "$ref": "SourceReference.json"
          },
          "epoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "tcp_flags": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            }
          }
        },
        "required": [
          "source_ref",
          "epoch",
          "tcp_flags",
          "endpoints"
        ],
        "additionalProperties": false
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "reasons"
      ],
      "additionalProperties": false
    },
    "schema_version": {
      "const": "1.0.0"
    }
  }
}
