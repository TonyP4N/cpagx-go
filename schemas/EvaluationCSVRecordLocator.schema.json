{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EvaluationCSVRecordLocator.schema.json",
  "title": "Explicit CSV logical data record locator",
  "type": "object",
  "properties": {
    "version": {"const": "csv-logical-record-1"},
    "file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record_number": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "columns": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true,
      "items": {"type": "string", "pattern": ".*\\S.*", "maxLength": 4096}}
  },
  "required": ["version", "file_sha256", "record_number", "columns"],
  "additionalProperties": false
}
