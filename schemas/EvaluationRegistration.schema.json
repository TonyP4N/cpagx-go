{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EvaluationRegistration.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d\\d:\\d\\d)$"
    },
    "holdout_opened_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d\\d:\\d\\d)$"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "split_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tolerance_seconds": {
      "type": "number",
      "minimum": 0
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "registered_at",
    "holdout_opened_at",
    "input_fingerprint",
    "config_fingerprint",
    "split_sha256",
    "tolerance_seconds",
    "thresholds",
    "synthetic"
  ],
  "additionalProperties": false
}
