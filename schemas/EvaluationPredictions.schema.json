{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EvaluationPredictions.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "run_id": {
      "type": "string"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "batch": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-]\\d\\d:\\d\\d)$"
          },
          "sample_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "batch",
          "kind",
          "asset",
          "time",
          "sample_sha256"
        ],
        "additionalProperties": false
      }
    },
    "unlabelled_relations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "run_id",
    "input_fingerprint",
    "config_fingerprint",
    "events",
    "unlabelled_relations"
  ],
  "additionalProperties": false
}
