FROM mirror.gcr.io/library/python@sha256:848ba4413eb897e225159b8fc1b02094576cbae4aa73fc13142608ae2c8c0e32
ARG TARGETARCH
COPY deployments/resident/build/${TARGETARCH}/cpagx-v3 /opt/cpag/bin/cpagx-v3
COPY deployments/resident/private_relay.py /opt/cpag/private_relay.py
COPY deployments/r21/k3s/source-verifier.py /opt/cpag/source-verifier.py
COPY services/analysis /opt/cpag/services/analysis
COPY schemas /opt/cpag/schemas
COPY webui/out /opt/cpag/webui/out
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/cpag
ENTRYPOINT ["/opt/cpag/bin/cpagx-v3"]
CMD ["--config", "/etc/cpag/app.json"]
