{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "cpag-postgres",
        "namespace": "cpag"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 0,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "cpag-postgres"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "cpag-postgres"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "cpag_app"
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  }
                ],
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "cpag-postgres"
                    }
                  }
                ],
                "image": "postgres@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94",
                "imagePullPolicy": "IfNotPresent",
                "name": "postgres",
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "postgres",
                      "-d",
                      "cpag_app"
                    ]
                  },
                  "failureThreshold": 3,
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "768Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/var/lib/postgresql/data",
                    "name": "data"
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 30,
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "cpag-postgres"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "cpag-postgres",
        "namespace": "cpag"
      },
      "spec": {
        "clusterIP": "10.43.83.88",
        "clusterIPs": [
          "10.43.83.88"
        ],
        "internalTrafficPolicy": "Cluster",
        "ipFamilies": [
          "IPv4"
        ],
        "ipFamilyPolicy": "SingleStack",
        "ports": [
          {
            "port": 5432,
            "protocol": "TCP",
            "targetPort": 5432
          }
        ],
        "selector": {
          "app": "cpag-postgres"
        },
        "sessionAffinity": "None",
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "cpag-control",
        "namespace": "cpag",
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "2Gi"
          }
        },
        "storageClassName": "local-path",
        "volumeMode": "Filesystem",
        "volumeName": "pvc-a1bc1f5c-b1ec-4ed5-b7a5-11a754ea1bb2"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "cpag-postgres",
        "namespace": "cpag",
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "8Gi"
          }
        },
        "storageClassName": "local-path",
        "volumeMode": "Filesystem",
        "volumeName": "pvc-0ae12381-4993-47f8-979d-9461b3de2386"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "cpag-shared",
        "namespace": "cpag",
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "32Gi"
          }
        },
        "storageClassName": "local-path",
        "volumeMode": "Filesystem",
        "volumeName": "pvc-5a909400-f7ee-492b-b185-d14971320f47"
      }
    }
  ]
}
